# Bancos (dentro do compose os hosts são os nomes dos serviços)
POSTGRES_USER=waitorbuy
POSTGRES_PASSWORD=waitorbuy
POSTGRES_DB=waitorbuy
DATABASE_URL=postgresql://waitorbuy:waitorbuy@postgres:5432/waitorbuy
MONGO_URL=mongodb://mongo:27017
MONGO_DB=waitorbuy

# APIs externas
RAWG_API_KEY=
ETL_INTERVAL_HOURS=4
ETL_PAUSE_SECONDS=1.5
ETL_USER_AGENT=WaitOrBuy-Academic/0.1 (student project)

# Backend
ADMIN_TOKEN=troque-este-token-admin
AFFILIATE_TAG=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
BACKEND_URL=http://backend:8000

# Modo do Firebase, escolhido por estas duas linhas (o docker compose lê COMPOSE_FILE/COMPOSE_PROFILES daqui):
#  - EMULADOR (padrão, funciona em qualquer clone, sem conta Google): como abaixo.
#  - FIREBASE REAL: COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.real.yml, apague COMPOSE_PROFILES, esvazie os dois *_EMULATOR_HOST,
#    ponha FIREBASE_PROJECT_ID=<seu projeto>, FIREBASE_CREDENTIALS=/run/secrets/firebase.json e salve a credencial em firebase/credentials.json.
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.emulator.yml
COMPOSE_PROFILES=emulator

# Firebase
FIREBASE_PROJECT_ID=demo-waitorbuy
FIRESTORE_EMULATOR_HOST=firebase:8080
FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
# Caminho do JSON da conta de serviço (opcional; habilita push FCM real)
FIREBASE_CREDENTIALS=
ETL_RUN_ON_START=false
