# Firebase real (produção). Sem estas variáveis o app usa os emuladores locais (demo-waitorbuy).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Chave pública Web Push (Firebase Console > Cloud Messaging > Web Push certificates). Sem ela, o push fica indisponível.
VITE_FCM_VAPID_KEY=
