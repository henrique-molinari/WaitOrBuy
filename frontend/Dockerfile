FROM node:20-slim
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
ARG VITE_API_URL=http://localhost:8000
ARG VITE_AUTH_EMULATOR=http://localhost:9099
ARG VITE_FIRESTORE_EMULATOR_HOST=localhost
ARG VITE_FIRESTORE_EMULATOR_PORT=8080
ENV VITE_API_URL=$VITE_API_URL VITE_AUTH_EMULATOR=$VITE_AUTH_EMULATOR VITE_FIRESTORE_EMULATOR_HOST=$VITE_FIRESTORE_EMULATOR_HOST VITE_FIRESTORE_EMULATOR_PORT=$VITE_FIRESTORE_EMULATOR_PORT
RUN npm run build
CMD ["npm", "run", "preview"]
