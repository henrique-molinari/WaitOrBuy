    {
      "_id": "uts_infra_t0",
      "_type": "unit_test",
      "parentId": "uts_infra",
      "name": "API e os 3 bancos estao no ar",
      "requestId": "req_health",
      "metaSortKey": 0,
      "code": "const response = await insomnia.send();\nconst body = JSON.parse(response.data);\nexpect(response.status).to.equal(200);\nexpect(body.status).to.equal('ok');\nexpect(body.postgres).to.equal(true);\nexpect(body.mongo).to.equal(true);\nexpect(body.firestore).to.equal(true);"
    },
