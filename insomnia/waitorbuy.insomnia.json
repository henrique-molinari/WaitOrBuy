    {
      "_id": "uts_public_t0",
      "_type": "unit_test",
      "parentId": "uts_public",
      "name": "Busca retorna jogos com ofertas ordenadas por preco",
      "requestId": "req_search",
      "metaSortKey": 0,
      "code": "const response = await insomnia.send();\nconst body = JSON.parse(response.data);\nexpect(response.status).to.equal(200);\nexpect(body.count).to.be.above(0);\nconst p = body.results[0].offers.map(o => o.price_brl);\nexpect(p).to.deep.equal([...p].sort((a, b) => a - b));\nbody.results[0].offers.forEach(o => expect(['steam_brl', 'converted_usd']).to.include(o.price_origin));"
    },
    {
      "_id": "uts_public_t1",
      "_type": "unit_test",
      "parentId": "uts_public",
      "name": "Busca sem resultado retorna lista vazia",
      "requestId": "req_search_empty",
      "metaSortKey": 1,
      "code": "const response = await insomnia.send();\nconst body = JSON.parse(response.data);\nexpect(response.status).to.equal(200);\nexpect(body.count).to.equal(0);"
    },
    {
      "_id": "uts_public_t2",
