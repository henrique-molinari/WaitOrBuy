    {
      "_id": "uts_public_t3",
      "_type": "unit_test",
      "parentId": "uts_public",
      "name": "Detalhe tem veredito valido e estatisticas",
      "requestId": "req_game",
      "metaSortKey": 3,
      "code": "const response = await insomnia.send();\nconst body = JSON.parse(response.data);\nexpect(response.status).to.equal(200);\nexpect(['COMPRAR_AGORA', 'ESPERAR', 'NEUTRO']).to.include(body.verdict.verdict);\nexpect(body.stats).to.be.an('object');\nexpect(body.offers).to.be.an('array');"
